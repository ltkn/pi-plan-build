{
  "name": "pi-plan-build",
  "version": "1.27.0",
  "description": "Plan → spec → build → review for the Pi coding agent: plan together, build each feature task by task behind checks the harness runs, then an independent, double-checked review.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "coding-agent",
    "spec",
    "plan",
    "review",
    "workflow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltkn/pi-plan-build.git"
  },
  "homepage": "https://github.com/ltkn/pi-plan-build#readme",
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/pb/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test test/pb.test.mts",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
